# ==============================================================================
# SaferPassForge — Environment Configuration Template
# Duplicate this file to .env and adjust values for your local environment.
# ==============================================================================

# Application Metadata & Runtime Environment
APP_NAME="SaferPassForge"
APP_ENV="development"

# Cryptographic and Application Secret Key (min 32 characters in production)
APP_SECRET_KEY="change-this-in-production-to-a-cryptographically-secure-key"

# Database Connection URL (SQLite for MVP)
DATABASE_URL="sqlite:///./saferpassforge.db"

# Default Password Generator Settings
DEFAULT_PASSWORD_LENGTH=16

